{
  "name": "@swiftnest/server-bundle",
  "version": "0.0.1",
  "description": "Swiftnest's built-in modules as a DeepSeek Harness bundle.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    "./native-devices": {
      "types": "./dist/native-devices.d.ts",
      "default": "./dist/native-devices.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "default": "./dist/core.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./memory": {
      "types": "./dist/memory.d.ts",
      "default": "./dist/memory.js"
    },
    "./vision": {
      "types": "./dist/vision.d.ts",
      "default": "./dist/vision.js"
    },
    "./routing": {
      "types": "./dist/routing.d.ts",
      "default": "./dist/routing.js"
    },
    "./native-pairings-store": {
      "types": "./dist/native-pairings-store.d.ts",
      "default": "./dist/native-pairings-store.js"
    },
    "./channel-identity": {
      "types": "./dist/channel-identity.d.ts",
      "default": "./dist/channel-identity.js"
    },
    "./media": {
      "types": "./dist/media.d.ts",
      "default": "./dist/media.js"
    },
    "./trusted-proxy": {
      "types": "./dist/trusted-proxy.d.ts",
      "default": "./dist/trusted-proxy.js"
    },
    "./chat-search": {
      "types": "./dist/chat-search.d.ts",
      "default": "./dist/chat-search.js"
    },
    "./web-fetch": {
      "types": "./dist/web-fetch.d.ts",
      "default": "./dist/web-fetch.js"
    }
  },
  "files": [
    "dist",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "tsc -b"
  },
  "dsh": {
    "bundle": {
      "patch": [
        "./cordis.patch.yml"
      ]
    }
  },
  "dependencies": {
    "@swiftnest/channel": "workspace:*",
    "@swiftnest/core": "workspace:*",
    "@swiftnest/protocol": "workspace:*",
    "ipaddr.js": "2.5.0",
    "undici": "^7.30.2",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-web": "0.2.2-rc.1",
    "@deepseek-ai/dsh-web-fetch-http": "0.2.2-rc.1",
    "@types/ws": "^8.18.2"
  }
}
