{
  "name": "@swiftnest/server-bundle",
  "version": "0.0.1",
  "description": "Swiftnest's built-in modules as a DeepSeek Harness bundle.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    "./native-devices": { "types": "./dist/native-devices.d.ts", "default": "./dist/native-devices.js" },
    "./core": { "types": "./dist/core.d.ts", "default": "./dist/core.js" },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": ["dist", "cordis.patch.yml"],
  "scripts": { "build": "tsc -b" },
  "dsh": { "bundle": { "patch": ["./cordis.patch.yml"] } }
}
