{
  "name": "swiftnest-monorepo",
  "private": true,
  "description": "Swiftnest — turn your devices into capabilities any agent can call safely.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24.9.0"
  },
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "playground": "node packages/cli/dist/bin.js playground",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "lint:i18n": "node scripts/i18n-lint.mjs",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome ci ."
  },
  "devDependencies": {
    "@babel/parser": "7.29.9",
    "@biomejs/biome": "2.6.4",
    "@types/node": "^24.0.0",
    "typescript": "^7.0.2",
    "vitepress": "^1.6.4",
    "vitest": "^5.0.5"
  }
}
