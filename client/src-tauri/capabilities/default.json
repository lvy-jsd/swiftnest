{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Local main window on desktop and Android. HTTP pairing/API paths on user-selected HTTP(S) hosts; WebSocket connect/send for the paired host. No platform restriction or remote-origin IPC.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    { "identifier": "http:default", "allow": [
      { "url": "http://*:*/connect" }, { "url": "https://*:*/connect" },
      { "url": "http://*:*/swiftnest/native/issue" }, { "url": "https://*:*/swiftnest/native/issue" },
      { "url": "http://*:*/swiftnest/native/resume" }, { "url": "https://*:*/swiftnest/native/resume" },
      { "url": "http://*:*/swiftnest/native/rotate" }, { "url": "https://*:*/swiftnest/native/rotate" },
      { "url": "http://*:*/swiftnest/native/bind" }, { "url": "https://*:*/swiftnest/native/bind" },
      { "url": "http://*:*/swiftnest/native/revoke" }, { "url": "https://*:*/swiftnest/native/revoke" },
      { "url": "http://*:*/swiftnest/api/chat" }, { "url": "https://*:*/swiftnest/api/chat" },
      { "url": "http://*:*/swiftnest/api/devices" }, { "url": "https://*:*/swiftnest/api/devices" },
      { "url": "http://*:*/swiftnest/api/devices/" }, { "url": "https://*:*/swiftnest/api/devices/" },
      { "url": "http://*:*/swiftnest/api/devices/approvals" }, { "url": "https://*:*/swiftnest/api/devices/approvals" },
      { "url": "http://*:*/swiftnest/api/devices/pairing" }, { "url": "https://*:*/swiftnest/api/devices/pairing" },
      { "url": "http://*:*/swiftnest/api/devices/transfers" }, { "url": "https://*:*/swiftnest/api/devices/transfers" },
      { "url": "http://*:*/swiftnest/api/devices/revoke/*" }, { "url": "https://*:*/swiftnest/api/devices/revoke/*" },
      { "url": "http://*:*/api/*" }, { "url": "https://*:*/api/*" },
      { "url": "http://*:*/swiftnest/health" }, { "url": "https://*:*/swiftnest/health" },
      { "url": "http://*:*/swiftnest/api/plugins" }, { "url": "https://*:*/swiftnest/api/plugins" },
      { "url": "http://*:*/swiftnest/api/plugins/*" }, { "url": "https://*:*/swiftnest/api/plugins/*" },
      { "url": "http://*:*/swiftnest/api/devices/events" }, { "url": "https://*:*/swiftnest/api/devices/events" },
      { "url": "http://*:*/swiftnest/api/devices/preferences" }, { "url": "https://*:*/swiftnest/api/devices/preferences" }
    ] },
    "websocket:allow-connect",
    "websocket:allow-send"
  ]
}
