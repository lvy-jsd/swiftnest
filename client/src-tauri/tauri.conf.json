{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Swiftnest",
  "version": "0.0.1",
  "identifier": "dev.swiftnest.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "label": "main", "title": "Swiftnest", "width": 1120, "height": 800, "minWidth": 360, "minHeight": 480 }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": { "active": true, "targets": ["deb", "appimage", "nsis"], "icon": ["icons/icon.png", "icons/icon.ico"] }
}
