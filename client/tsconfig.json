{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "node"],
    "jsx": "react-jsx",
    "rootDir": ".",
    "outDir": ".build",
    "emitDeclarationOnly": true
  },
  "include": ["src", "test", "vite.config.ts"],
  "references": [{ "path": "../packages/api" }, { "path": "../server" }]
}
